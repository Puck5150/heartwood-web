---
interface Props {
  size?: number;
  class?: string;
}
const { size = 320, class: className = '' } = Astro.props as Props;
---
<svg
  class={`tree-rings ${className}`}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="98" cy="103" r="14" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.55" />
  <circle cx="101" cy="100" r="28" stroke="var(--color-ring)" stroke-width="1" opacity="0.55" />
  <circle cx="97" cy="102" r="43" stroke="var(--color-accent)" stroke-width="1.25" opacity="0.4" />
  <circle cx="100" cy="98" r="59" stroke="var(--color-ring)" stroke-width="1" opacity="0.45" />
  <circle cx="102" cy="101" r="76" stroke="var(--color-ring)" stroke-width="1" opacity="0.3" />
  <circle cx="98" cy="99" r="94" stroke="var(--color-accent)" stroke-width="1" opacity="0.2" />
</svg>

<style>
  .tree-rings {
    display: block;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderBlock from '../components/PlaceholderBlock.astro';
---
<BaseLayout title="Download — Heartwood">
  <section class="download">
    <h1>Download Heartwood</h1>
    <p>Local-first. No accounts, no telemetry, no cloud.</p>

    <div class="download__grid">
      <article class="download__card">
        <h2>macOS</h2>
        <span class="download__button" role="note">Coming soon</span>
      </article>
      <article class="download__card">
        <h2>Windows</h2>
        <span class="download__button" role="note">Coming soon</span>
      </article>
      <article class="download__card">
        <h2>Linux</h2>
        <span class="download__button" role="note">Coming soon</span>
      </article>
    </div>

    <PlaceholderBlock
      label="System requirements go here"
      note="Minimum OS versions and hardware requirements will be listed once builds are finalized."
    />
  </section>
</BaseLayout>

<style>
  .download {
    max-width: 44rem;
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-6);
    text-align: center;
  }
  .download > p {
    max-width: 40ch;
    margin-inline: auto;
    opacity: 0.85;
  }
  .download__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin: var(--space-5) 0 var(--space-6) 0;
  }
  .download__card {
    flex: 1 1 12rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: var(--space-4) var(--space-3);
    background: var(--color-bg-alt);
  }
  .download__card h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
  }
  .download__button {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 100px;
    background: var(--color-border);
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    text-decoration: none;
    cursor: default;
  }
  @media (max-width: 700px) {
    .download__grid { flex-direction: column; }
  }
</style>

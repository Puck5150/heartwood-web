---
import BaseLayout from '../layouts/BaseLayout.astro';
import GreenhouseDemo from '../components/GreenhouseDemo.astro';
import PlaceholderBlock from '../components/PlaceholderBlock.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Heartwood — A focus timer for a mind that wanders">
  <section class="hero">
    <div class="hero__copy">
      <h1>A place to set your mind down.</h1>
      <p>
        Heartwood is a focus timer for macOS, Windows, and Linux. When a
        thought pulls at you mid-session, you capture it in the Greenhouse
        and keep working — nothing is lost, nothing has to be decided
        right now.
      </p>
    </div>
    <GreenhouseDemo />
  </section>

  <section class="recording reveal">
    <PlaceholderBlock
      label="Real session recording goes here"
      note="A short screen recording of an actual Heartwood session will replace this block."
    />
  </section>

  <section class="flow reveal">
    <div class="flow__inner">
      <h2>Flow is the point.</h2>
      <p>Deep focus doesn't survive being managed — it survives being protected. Heartwood gets out of the way: one visible timer, one place to set a thought down, nothing else competing for your eyes while you work.</p>
    </div>
  </section>

  <section class="features reveal">
    <h2>What else is here</h2>
    <ul>
      <li><strong>Soundscapes</strong> — one included free, more with the full version.</li>
      <li><strong>Touch grass</strong> — a deliberate extended-break button, for when focus runs dry.</li>
      <li><strong>Markdown session notes</strong> — write plainly, format if you want to.</li>
      <li><strong>Versioned history</strong> — everything you've ever written, kept.</li>
      <li><strong>Local-first</strong> — everything stays on your machine, no accounts slowing you down.</li>
    </ul>
  </section>

  <section class="cta reveal">
    <a class="cta__button" href={`${base}/download`}>Download Heartwood</a>
    <a class="cta__link" href={`${base}/pricing`}>See pricing</a>
  </section>
</BaseLayout>

<style>
  .hero, .recording, .features {
    padding: var(--space-4);
    max-width: 48rem;
    margin: 0 auto;
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  .hero__copy {
    flex: 1 1 24rem;
  }
  .hero h1 {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    max-width: 14ch;
  }
  .hero__copy p {
    font-size: var(--text-lead);
    max-width: 42ch;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .recording {
    padding-top: 0;
    padding-bottom: var(--space-6);
  }
  .flow {
    background: var(--color-flow-surface);
    padding: var(--space-7) var(--space-4);
  }
  .flow__inner {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }
  .flow h2 {
    font-size: var(--text-h2);
  }
  .flow p {
    max-width: 52ch;
    margin-inline: auto;
  }
  .features {
    padding-top: var(--space-7);
    padding-bottom: var(--space-6);
  }
  .features h2 {
    margin-bottom: var(--space-4);
  }
  .features ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .features li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) 1.75rem;
    max-width: 60ch;
    border-top: 1px solid var(--color-border);
  }
  .features li:first-child {
    border-top: none;
  }
  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--space-3) + 0.7em);
    width: 10px;
    height: 10px;
    transform: translateY(-50%);
    background-image:
      radial-gradient(circle, transparent 3.5px, var(--color-accent) 4px, var(--color-accent) 4.3px, transparent 4.8px),
      radial-gradient(circle, var(--color-accent) 1.3px, transparent 1.8px);
    opacity: 0.75;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
    padding: var(--space-7) var(--space-4);
    background: var(--color-accent);
    color: var(--color-bg);
    text-align: center;
  }
  .cta__button {
    background: var(--color-bg);
    color: var(--color-accent);
    padding: var(--space-2) var(--space-4);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta__button:hover {
    transform: translateY(-2px);
  }
  .cta__link {
    color: var(--color-bg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cta :focus-visible {
    outline-color: var(--color-bg);
  }
  @media (max-width: 700px) {
    .hero { flex-direction: column; align-items: flex-start; }
    .hero h1 { max-width: none; }
  }
</style>
